<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل دانلود و کانفیگ</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Tahoma, Arial, sans-serif;
        }
        body {
            background-color: #0b0f19;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            width: 100%;
            max-width: 450px;
            background: #111827;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            text-align: center;
            border: 1px solid #1f2937;
        }
        h1 {
            color: #38bdf8;
            font-size: 22px;
            margin-bottom: 6px;
        }
        p.subtitle {
            color: #9ca3af;
            font-size: 13px;
            margin-bottom: 20px;
        }
        .section {
            background: #1f2937;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 12px;
            text-align: right;
            border: 1px solid #374151;
        }
        .section-title {
            font-size: 14px;
            font-weight: bold;
            color: #e2e8f0;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .config-box {
            background: #030712;
            padding: 10px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 12px;
            color: #4ade80;
            word-break: break-all;
            margin-bottom: 8px;
            border: 1px solid #1e293b;
        }
        .btn {
            background: #0284c7;
            color: #fff;
            border: none;
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn:hover {
            background: #0369a1;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>VPN PANEL</h1>
    <p class="subtitle">فهرست کانفیگ‌ها و سرویس‌های فعال ✨</p>

    <!-- بخش اول: V2Ray -->
    <div class="section">
        <div class="section-title">⚡ کانفیگ V2Ray</div>
        <div class="config-box" id="conf1">vless://your-config-key-here...</div>
        <button class="btn" onclick="copyText('conf1')">کپی کانفیگ</button>
    </div>

    <!-- بخش دوم: WireGuard -->
    <div class="section">
        <div class="section-title">🐉 کانفیگ WireGuard</div>
        <div class="config-box" id="conf2">wireguard-config-data-or-link...</div>
        <button class="btn" onclick="copyText('conf2')">کپی کانفیگ</button>
    </div>

    <!-- بخش سوم: OpenVPN -->
    <div class="section">
        <div class="section-title">🔐 کانفیگ OpenVPN</div>
        <div class="config-box" id="conf3">openvpn-profile-link-here...</div>
        <button class="btn" onclick="copyText('conf3')">کپی لینک پروفایل</button>
    </div>

</div>

<script>
    function copyText(containerId) {
        const text = document.getElementById(containerId).innerText;
        navigator.clipboard.writeText(text).then(() => {
            alert('کانفیگ با موفقیت کپی شد!');
        });
    }
</script>

</body>
</html>
